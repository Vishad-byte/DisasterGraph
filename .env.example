# Neo4j Database (Neo4j AuraDB Free tier or local Neo4j instance)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-generated-password

# System Mode: "demo" (cached historical data) or "live" (real-time free feeds)
DATA_MODE=demo
TARGET_CITY="Delhi, India"
# Bounding box format: south,west,north,east
BBOX=28.38,76.78,28.92,77.42

# Free API Keys (both 100% free with simple sign-up, no credit card)
# NASA FIRMS MAP Key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your-nasa-firms-map-key
# OpenAQ API Key (optional, free tier): https://explore.openaq.org/register
OPENAQ_API_KEY=your-openaq-key

# LLM Provider Configuration
# Supported providers: "openrouter" (free :free models supported), "groq" (free tier), "gemini" (free tier), "claude"
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-3.5-sonnet
# For free open models on OpenRouter, you can use: meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=DisasterGraph

# Alternative Free LLM Keys
# Groq (Ultra-fast free inference): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (Free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Ingestion Poll Intervals (in seconds)
POLL_INTERVAL_FIRMS=900
POLL_INTERVAL_USGS=60
POLL_INTERVAL_EONET=600
POLL_INTERVAL_GDACS=600
POLL_INTERVAL_OPEN_METEO=1800
POLL_INTERVAL_AIR_QUALITY=900
POLL_INTERVAL_PRUNE=3600

# Event Expiration / Retention (hours before archiving/pruning to stay well within AuraDB 200k limit)
EVENT_TTL_HOURS=24

# Telegram Bot (Free alerts to emergency response officers)
TELEGRAM_TOKEN=your-telegram-token
OFFICER_CHAT_IDS={"zone_001":"123456789"}

# Services & Caches
INGESTION_SERVICE_URL=http://127.0.0.1:8001
OSM_CACHE_DIR=data/cache
FIRMS_CACHE_PATH=data/cache/firms.csv
SENTINEL_CACHE_PATH=data/cache/sentinel_no2.csv
DELHI_FLOOD_CACHE_PATH=data/cache/delhi_flood_2023.csv
CENSUS_WARDS_GEOJSON=data/cache/delhi_wards.geojson

# Road Network & Routing Configuration
ROUTING_PROVIDER=osmnx
ROUTING_BBOX=28.38,76.78,28.92,77.42
ROAD_GRAPH_CACHE_PATH=data/cache/osm_delhi_india_roads.graphml
HAZARD_PENALTY_AVOID=1.5,4.0
HAZARD_BUFFER_M=500.0

AGENT_LOOP_SECONDS=300
AGENT_VERBOSE=true
